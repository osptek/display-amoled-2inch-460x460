 static void dw_mipi_dsi_phy_tx_config(struct dw_mipi_dsi_rockchip *dsi)
 {
+	u32 lanecfg1 = dsi->cdata->lanecfg1;
+
+	/*
+	 * The RK3506 GRF bits statically enable both lane pads, while the
+	 * D-PHY only powers the lanes given by dsi,lanes. Enabling an unused
+	 * pad keeps its PPI stopstate from settling, which stalls HS
+	 * transmission (to_hs_tx), so derive the lane enables from the
+	 * configured lane count.
+	 */
+	if (dsi->cdata->soc_type == RK3506) {
+		u32 val = RK3506_DSI_PHY_ENABLE_LANE0;
+
+		if (dsi->lanes > 1)
+			val |= RK3506_DSI_PHY_ENABLE_LANE1;
+
+		lanecfg1 = HIWORD_UPDATE(val,
+					 RK3506_DSI_TURNDISABLE |
+					 RK3506_DSI_FORCERXMODE |
+					 RK3506_DSI_FORCETXSTOPMODE |
+					 RK3506_DSI_PHY_ENABLE_LANE0 |
+					 RK3506_DSI_PHY_ENABLE_LANE1);
+	}
+
 	if (dsi->cdata->lanecfg1_grf_reg)
 		regmap_write(dsi->grf_regmap, dsi->cdata->lanecfg1_grf_reg,
-					      dsi->cdata->lanecfg1);
+					      lanecfg1);
 
